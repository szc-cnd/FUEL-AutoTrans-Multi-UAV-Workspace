<launch>
  <!--
    UAV1 前视检测独立入口。
    下视相机、搜索和精降仍由 leader_safe_path_follower.launch 统一持有，
    本入口只启动 D435、目标检测/上报和 RViz 所需的检测标记发布器。
  -->
  <arg name="enable_realsense" default="true" />
  <arg name="enable_color_tag" default="true" />
  <arg name="enable_qr" default="true" />
  <arg name="enable_front_aruco" default="true" />
  <arg name="enable_thermal" default="true" />
  <arg name="enable_thermal_d435_fusion" default="true" />
  <arg name="enable_target_reporting" default="true" />
  <arg name="target_reporting_mission_id" default="" />

  <arg name="odom_topic" default="/UAV1/fast_lio/Odom_high_freq" />
  <arg name="world_frame" default="UAV1/camera_init" />
  <arg name="body_frame" default="UAV1/body" />
  <arg name="camera_namespace" default="UAV1/camera" />
  <arg name="camera_tf_prefix" default="UAV1_camera" />
  <arg name="camera_link_frame" default="UAV1_camera_link" />
  <arg name="camera_optical_frame" default="UAV1_camera_color_optical_frame" />
  <arg name="camera_body_calibration_file"
       default="$(env HOME)/handeye_calibration/body_camera_03.yaml" />

  <!-- D435 的节点、话题和 TF 均加 UAV1 前缀，避免共享 ROS Master 时顶掉 UAV0。 -->
  <include if="$(arg enable_realsense)"
           file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera" value="$(arg camera_namespace)" />
    <arg name="tf_prefix" value="$(arg camera_tf_prefix)" />
    <arg name="align_depth" value="true" />
    <arg name="enable_color" value="true" />
    <arg name="enable_depth" value="true" />
    <arg name="color_width" value="1280" />
    <arg name="color_height" value="720" />
    <arg name="color_fps" value="30" />
    <arg name="depth_width" value="1280" />
    <arg name="depth_height" value="720" />
    <arg name="depth_fps" value="30" />
    <arg name="enable_pointcloud" value="true" />
  </include>

  <!-- QR使用原始30Hz；其余前视检测每两帧取一帧，降低重复图像处理开销。 -->
  <node if="$(arg enable_realsense)" pkg="topic_tools" type="drop"
        name="uav1_aux_color_drop"
        args="/UAV1/camera/color/image_raw 1 2 /UAV1/camera/aux/color/image_raw" />
  <node if="$(arg enable_realsense)" pkg="topic_tools" type="drop"
        name="uav1_aux_depth_drop"
        args="/UAV1/camera/aligned_depth_to_color/image_raw 1 2 /UAV1/camera/aux/aligned_depth_to_color/image_raw" />

  <node if="$(arg enable_color_tag)" pkg="color_tag_detector"
        type="color_tag_detector.py" name="uav1_color_tag_detector"
        output="screen">
    <rosparam command="load"
              file="$(find color_tag_detector)/config/color_thresholds.yaml" />
    <param name="color_topic" value="/UAV1/camera/aux/color/image_raw" />
    <param name="depth_topic"
           value="/UAV1/camera/aux/aligned_depth_to_color/image_raw" />
    <param name="camera_info_topic" value="/UAV1/camera/color/camera_info" />
    <param name="candidate_point_topic"
           value="/UAV1/color_tag_detector/candidate_point_camera" />
    <param name="candidate_text_topic"
           value="/UAV1/color_tag_detector/candidate_text" />
    <remap from="/UAV0/color_tag_detector/debug_image"
           to="/UAV1/color_tag_detector/debug_image" />
    <remap from="/UAV0/color_tag_detector/mask"
           to="/UAV1/color_tag_detector/mask" />
    <remap from="/UAV0/color_tag_detector/target_point_camera"
           to="/UAV1/color_tag_detector/target_point_camera" />
    <remap from="/UAV0/color_tag_detector/result_text"
           to="/UAV1/color_tag_detector/result_text" />
  </node>

  <node if="$(arg enable_qr)" pkg="qr_detector"
        type="qr_detector_node.py" name="uav1_qr_detector" output="screen">
    <rosparam command="load" file="$(find qr_detector)/config/qr_detector.yaml" />
    <param name="image_topic" value="/UAV1/camera/color/image_raw" />
    <param name="depth_topic"
           value="/UAV1/camera/aligned_depth_to_color/image_raw" />
    <param name="camera_info_topic" value="/UAV1/camera/color/camera_info" />
    <param name="candidate_pose_topic"
           value="/UAV1/vision/qr_candidate_pose_camera" />
    <param name="candidate_detected_topic"
           value="/UAV1/vision/qr_candidate_detected" />
    <remap from="/UAV0/vision/qr_pose_camera"
           to="/UAV1/vision/qr_pose_camera" />
    <remap from="/UAV0/vision/qr_detected"
           to="/UAV1/vision/qr_detected" />
    <remap from="/UAV0/vision/qr_debug_image"
           to="/UAV1/vision/qr_debug_image" />
  </node>

  <!-- UAV1 使用自身 D435 外参，不发布世界到机体 TF。 -->
  <node pkg="target_reporting" type="publish_camera_extrinsic_tf.py"
        name="uav1_body_camera_static_tf" output="screen">
    <param name="calibration_file" value="$(arg camera_body_calibration_file)" />
    <param name="parent_frame" value="$(arg body_frame)" />
    <param name="child_frame" value="$(arg camera_link_frame)" />
  </node>

  <!-- 只把前视 ArUco 结果用于检测显示；提示和候选发布到隔离话题，不介入降落控制。 -->
  <node if="$(arg enable_front_aruco)" pkg="precision_landing"
        type="front_aruco_hint_node" name="uav1_front_aruco_detector"
        output="screen">
    <rosparam command="load"
              file="$(find precision_landing)/config/front_aruco_hint.yaml" />
    <param name="topics/image" value="/UAV1/camera/aux/color/image_raw" />
    <param name="topics/camera_info" value="/UAV1/camera/color/camera_info" />
    <param name="topics/aligned_depth"
           value="/UAV1/camera/aux/aligned_depth_to_color/image_raw" />
    <param name="topics/odometry" value="$(arg odom_topic)" />
    <param name="topics/mission_status" value="/UAV1/mission/task_status" />
    <param name="topics/hint_world" value="/UAV1/detection/front_aruco_hint" />
    <param name="topics/candidates" value="/UAV1/detection/front/candidates" />
    <param name="topics/locked_id" value="/UAV1/detection/front/locked_id" />
    <param name="topics/status" value="/UAV1/detection/front/status" />
    <param name="topics/debug_image" value="/UAV1/landing/front/debug_image" />
    <param name="frames/body" value="$(arg body_frame)" />
    <param name="frames/output_world" value="$(arg world_frame)" />
    <param name="frames/camera_optical" value="$(arg camera_optical_frame)" />
    <param name="mission/require_stage_gate" value="false" />
  </node>

  <!-- UAV1 默认启动热成像检测；无设备的维护场景可由入口显式关闭。 -->
  <node if="$(arg enable_thermal)" pkg="uvc_ubuntu"
        type="thermal_ros_node.py" name="uav1_thermal_detector" output="screen">
    <rosparam command="load" file="$(find uvc_ubuntu)/config/thermal_detector.yaml" />
    <param name="candidate_detected_topic"
           value="/UAV1/thermal/target_candidate_detected" />
    <param name="candidate_status_topic"
           value="/UAV1/thermal/target_candidate_status" />
    <param name="candidate_pixel_topic"
           value="/UAV1/thermal/target_candidate_pixel" />
    <remap from="/UAV0/thermal/image_raw" to="/UAV1/thermal/image_raw" />
    <remap from="/UAV0/thermal/debug_image" to="/UAV1/thermal/debug_image" />
    <remap from="/UAV0/thermal/target_detected"
           to="/UAV1/thermal/target_detected" />
    <remap from="/UAV0/thermal/target_pixel"
           to="/UAV1/thermal/target_pixel" />
  </node>

  <group if="$(arg enable_thermal)">
    <node if="$(arg enable_thermal_d435_fusion)" pkg="uvc_ubuntu"
          type="thermal_d435_fusion_node.py"
          name="uav1_thermal_d435_fusion" output="screen">
    <param name="config_path"
           value="$(find uvc_ubuntu)/config/thermal_d435_fusion.yaml" />
    <rosparam command="load"
              file="$(find uvc_ubuntu)/config/thermal_d435_fusion.yaml" />
    <param name="thermal_target_detected_topic"
           value="/UAV1/thermal/target_detected" />
    <param name="thermal_target_pixel_topic" value="/UAV1/thermal/target_pixel" />
    <param name="thermal_candidate_detected_topic"
           value="/UAV1/thermal/target_candidate_detected" />
    <param name="thermal_candidate_pixel_topic"
           value="/UAV1/thermal/target_candidate_pixel" />
    <param name="thermal_candidate_status_topic"
           value="/UAV1/thermal/target_candidate_status" />
    <param name="thermal_candidate_camera_point_topic"
           value="/UAV1/thermal/target_candidate_camera_point" />
    <param name="d435_camera_info_topic" value="/UAV1/camera/color/camera_info" />
    <param name="d435_depth_topic"
           value="/UAV1/camera/aux/aligned_depth_to_color/image_raw" />
    <param name="d435_color_topic" value="/UAV1/camera/aux/color/image_raw" />
    <param name="d435_debug_image_topic" value="/UAV1/thermal/d435_debug_image" />
    <param name="target_frame" value="$(arg world_frame)" />
    <param name="d435_optical_frame" value="$(arg camera_optical_frame)" />
    <remap from="/UAV0/thermal/target_d435_pixel"
           to="/UAV1/thermal/target_d435_pixel" />
    <remap from="/UAV0/thermal/target_camera_point"
           to="/UAV1/thermal/target_camera_point" />
    <remap from="/UAV0/thermal/target_channel_position"
           to="/UAV1/thermal/target_channel_position" />
    <remap from="/UAV0/thermal/fusion_valid"
           to="/UAV1/thermal/fusion_valid" />
    </node>
  </group>

  <node if="$(arg enable_target_reporting)" pkg="target_reporting"
        type="target_reporter_node.py" name="uav1_target_reporter" output="screen">
    <rosparam command="load"
              file="$(find target_reporting)/config/target_reporting.yaml" />
    <param name="drone_id" value="uav1" />
    <param name="localization_frame" value="$(arg world_frame)" />
    <param name="record_root" value="~/target_reports/uav1" />
    <param if="$(eval arg('target_reporting_mission_id') != '')"
           name="mission_id" value="$(arg target_reporting_mission_id)" />
    <param name="color_candidate_point_topic"
           value="/UAV1/color_tag_detector/candidate_point_camera" />
    <param name="color_candidate_status_topic"
           value="/UAV1/color_tag_detector/candidate_text" />
    <param name="qr_candidate_point_topic"
           value="/UAV1/vision/qr_candidate_pose_camera" />
    <param name="qr_candidate_status_topic"
           value="/UAV1/vision/qr_candidate_detected" />
    <param name="thermal_candidate_point_topic"
           value="/UAV1/thermal/target_candidate_camera_point" />
    <param name="thermal_candidate_status_topic"
           value="/UAV1/thermal/target_candidate_status" />
    <param name="thermal_d435_debug_image_topic"
           value="/UAV1/thermal/d435_debug_image" />
    <remap from="/UAV0/target_reporting/observation"
           to="/UAV1/target_reporting/observation" />
    <remap from="/UAV0/color_tag_detector/debug_image"
           to="/UAV1/color_tag_detector/debug_image" />
    <remap from="/UAV0/vision/qr_debug_image"
           to="/UAV1/vision/qr_debug_image" />
    <remap from="/UAV0/thermal/debug_image" to="/UAV1/thermal/debug_image" />
  </node>

  <!-- RViz 已由 Diff 分屏启动；这里只发布 UAV1 目标、点云和包围框。 -->
  <node pkg="target_reporting" type="target_rviz_marker_node.py"
        name="uav1_target_rviz_marker" output="screen">
    <param name="observation_topic" value="/UAV1/target_reporting/observation" />
    <param name="marker_topic" value="/UAV1/target_reporting/markers" />
    <param name="marker_frame" value="$(arg world_frame)" />
    <param name="cloud_topic" value="/UAV1/camera/depth/color/points" />
    <param name="enable_object_cloud" value="true" />
    <param name="object_cloud_topic"
           value="/UAV1/target_reporting/detected_object_cloud" />
    <param name="object_box_topic"
           value="/UAV1/target_reporting/detected_object_boxes" />
  </node>
</launch>
