<launch>
  <!--
    UAV0 统一启动入口。
    默认启动 D435、三类检测和 target_reporting；下视相机、精确降落和独立 RViz
    显示可由调用入口选择。精确降落节点启动后仍等待 /UAV0/need_to_land。
  -->
  <arg name="enable_realsense" default="true" />
  <arg name="enable_color_tag" default="true" />
  <arg name="enable_qr" default="true" />
  <arg name="enable_thermal" default="true" />
  <!-- 已完成热成像到 D435 单应矩阵标定，默认同时进行深度融合。 -->
  <arg name="enable_thermal_d435_fusion" default="true" />
  <arg name="enable_camera_body_tf" default="true" />
  <arg name="enable_target_reporting" default="true" />
  <!-- 留空时由 target_reporting 按当天日期生成 onboard_test_YYYYMMDD。 -->
  <arg name="target_reporting_mission_id" default="" />
  <arg name="enable_target_rviz" default="false" />
  <arg name="target_rviz_open_rviz" default="true" />
  <arg name="enable_down_camera" default="false" />
  <arg name="enable_precision_landing" default="false" />
  <arg name="enable_dual_uav_landing_coordinator" default="true" />
  <!-- 搜索降落节点默认待命，实际任务只由 UAV0 CH9 人工触发。
       维护时可设置 UAV0_ENABLE_SEARCH_LANDING=false 完全关闭。 -->
  <arg name="enable_search_landing"
       default="$(optenv UAV0_ENABLE_SEARCH_LANDING true)" />
  <!-- 比赛模式使用D435粗定位加速；最终降落仍只接受下视final_aruco。 -->
  <arg name="enable_front_aruco_hint" default="true" />
  <arg name="landing_vehicle_ns" default="UAV0" />

  <arg name="realsense_align_depth" default="true" />
  <arg name="realsense_enable_color" default="true" />
  <arg name="realsense_enable_depth" default="true" />
  <arg name="realsense_color_width" default="1280" />
  <arg name="realsense_color_height" default="720" />
  <arg name="realsense_depth_width" default="1280" />
  <arg name="realsense_depth_height" default="720" />
  <!-- D435 点云只用于 RViz 可视化，不参与检测或规划决策。 -->
  <arg name="realsense_enable_pointcloud" default="true" />
  <!-- 当前 FAST-LIO 已发布 UAV0/camera_init -> UAV0/body，默认不重复桥接里程计 TF。 -->
  <arg name="enable_camera_body_odom_tf" default="false" />
  <arg name="camera_body_tf_odom_topic" default="/UAV0/fast_lio/Odom_high_freq" />
  <!-- 当前 FAST-LIO/UAV0 使用 UAV0/body；相机驱动仍发布 camera_link。 -->
  <arg name="camera_body_tf_parent_frame" default="UAV0/body" />
  <arg name="camera_body_tf_child_frame" default="camera_link" />
  <arg name="camera_body_tf_calibration_file"
       default="$(env HOME)/handeye_calibration/body_camera_03.yaml" />
  <arg name="down_camera_device"
       default="/dev/v4l/by-id/usb-Generic_USB_Camera_YHTek-video-index0" />
  <arg name="down_camera_info_url"
       default="file://$(env HOME)/.ros/camera_info/down_camera.yaml" />
  <arg name="landing_image_topic" default="/UAV0/down_camera/image_raw" />
  <arg name="landing_camera_info_topic" default="/UAV0/down_camera/camera_info" />

  <!-- D435 只启动一次；颜色和二维码检测共用它的图像/深度话题。 -->
  <include if="$(arg enable_realsense)"
           file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="align_depth" value="$(arg realsense_align_depth)" />
    <arg name="enable_color" value="$(arg realsense_enable_color)" />
    <arg name="enable_depth" value="$(arg realsense_enable_depth)" />
    <arg name="color_width" value="$(arg realsense_color_width)" />
    <arg name="color_height" value="$(arg realsense_color_height)" />
    <arg name="depth_width" value="$(arg realsense_depth_width)" />
    <arg name="depth_height" value="$(arg realsense_depth_height)" />
    <arg name="enable_pointcloud" value="$(arg realsense_enable_pointcloud)" />
  </include>

  <include if="$(arg enable_color_tag)"
           file="$(find color_tag_detector)/launch/color_tag_detector.launch" />

  <include if="$(arg enable_qr)"
           file="$(find qr_detector)/launch/qr_detector.launch" />

  <!-- thermal_d435_system 同时启动 UVC 热源检测和 D435 深度融合。 -->
  <include if="$(arg enable_thermal)"
           file="$(find uvc_ubuntu)/launch/thermal_d435_system.launch">
    <arg name="enable_fusion" value="$(arg enable_thermal_d435_fusion)" />
  </include>

  <!-- 默认只发布机体到相机的静态外参；FAST-LIO 自行提供世界到机体的 TF。 -->
  <include if="$(arg enable_camera_body_tf)"
           file="$(find target_reporting)/launch/camera_body_tf.launch">
    <arg name="enable_odom_tf" value="$(arg enable_camera_body_odom_tf)" />
    <arg name="odom_topic" value="$(arg camera_body_tf_odom_topic)" />
    <arg name="calibration_file" value="$(arg camera_body_tf_calibration_file)" />
    <arg name="parent_frame" value="$(arg camera_body_tf_parent_frame)" />
    <arg name="child_frame" value="$(arg camera_body_tf_child_frame)" />
  </include>

  <include if="$(arg enable_target_reporting)"
           file="$(find target_reporting)/launch/target_reporting.launch">
    <arg name="mission_id" value="$(arg target_reporting_mission_id)" />
  </include>

  <!-- 规划器 launch 已经提供同一 RViz 中的 target_rviz_marker；只有独立查看时才打开本项。 -->
  <include if="$(arg enable_target_rviz)"
           file="$(find target_reporting)/launch/target_rviz.launch">
    <arg name="open_rviz" value="$(arg target_rviz_open_rviz)" />
  </include>

  <!-- 打开后仍需外部发布 /UAV0/need_to_land=true 才会进入降落控制。 -->
  <include if="$(arg enable_down_camera)"
           file="$(find precision_landing)/launch/down_camera.launch">
    <arg name="video_device" value="$(arg down_camera_device)" />
    <arg name="camera_info_url" value="$(arg down_camera_info_url)" />
    <arg name="vehicle_ns" value="$(arg landing_vehicle_ns)" />
  </include>

  <group if="$(arg enable_search_landing)">
    <include if="$(arg enable_precision_landing)"
             file="$(find precision_landing)/launch/precision_landing.launch">
      <arg name="image_topic" value="$(arg landing_image_topic)" />
      <arg name="camera_info_topic" value="$(arg landing_camera_info_topic)" />
      <arg name="vehicle_ns" value="$(arg landing_vehicle_ns)" />
      <arg name="landing_search_config"
           value="$(find precision_landing)/config/landing_search.yaml" />
      <arg name="enable_front_aruco_hint" value="$(arg enable_front_aruco_hint)" />
      <arg name="require_platform_assignment"
           value="$(arg enable_dual_uav_landing_coordinator)" />
    </include>

    <!-- 只在前机启动一份；通过 ROS/WiFi 话题协调两机使用不同 ArUco 平台。 -->
    <include if="$(arg enable_dual_uav_landing_coordinator)"
             file="$(find precision_landing)/launch/dual_uav_landing_coordinator.launch" />
  </group>
</launch>
