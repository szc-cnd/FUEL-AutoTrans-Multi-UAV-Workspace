<launch>
  <arg name="video_device"
       default="/dev/v4l/by-id/usb-Generic_USB_Camera_YHTek-video-index0"/>
  <arg name="camera_info_url"
       default="file:///home/oem/.ros/camera_info/down_camera.yaml"/>

  <node name="usb_cam"
        pkg="usb_cam"
        type="usb_cam_node"
        output="screen">
    <param name="video_device"
           value="$(arg video_device)"/>
    <param name="image_width" value="640"/>
    <param name="image_height" value="480"/>
    <param name="framerate" value="60"/>
    <param name="pixel_format" value="mjpeg"/>
    <param name="io_method" value="mmap"/>

    <param name="camera_name" value="down_camera"/>
    <param name="camera_frame_id" value="down_camera_optical_frame"/>
    <param name="camera_info_url"
           value="$(arg camera_info_url)"/>
  </node>
</launch>
