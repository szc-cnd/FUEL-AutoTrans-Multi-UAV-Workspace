<launch>
  <!-- CAV1 单机集成入口：传感器/MAVROS 由 start_autotrans_quad_wind_lidar.sh 启动。 -->
  <!-- NMPC 状态来源：FAST-LIO 高频预测里程计，提供 camera_init 世界系位置、速度和机体姿态。 -->
  <arg name="odom_topic" default="/UAV1/fast_lio/Odom_high_freq"/>
  <!-- Diff-Planner 与 NMPC 统一使用 FAST-LIO 高频预测里程计，避免两套状态源产生时刻偏差。 -->
  <arg name="planner_odom_topic" default="/UAV1/fast_lio/Odom_high_freq"/>
  <arg name="cloud_topic" default="/UAV1/fast_lio/cloud_registered"/>
  <arg name="trajectory_topic" default="/drone_1_planning/autotrans_trajectory"/>
  <arg name="frame_id" default="UAV1/camera_init"/>
  <!-- 外力估计使用 PX4/MAVROS 已对齐到机体系的 IMU：加速度单位 m/s^2，角速度单位 rad/s。 -->
  <arg name="imu_topic" default="/UAV1/mavros/imu/data"/>
  <!-- 外力估计姿态与 NMPC 统一使用 FAST-LIO 高频预测里程计。 -->
  <arg name="force_attitude_odom_topic" default="$(arg odom_topic)"/>
  <arg name="state_topic" default="/UAV1/mavros/state"/>
  <arg name="extended_state_topic" default="/UAV1/mavros/extended_state"/>
  <arg name="rc_topic" default="/UAV1/mavros/rc/in"/>
  <arg name="battery_topic" default="/UAV1/mavros/battery"/>
  <arg name="esc_status_topic" default="/UAV1/mavros/esc_status"/>
  <!-- AutoTrans 直接发布 MAVROS AttitudeTarget：body_rate 为机体系 rad/s，thrust 为归一化推力而非 N。 -->
  <arg name="setpoint_topic" default="/UAV1/mavros/setpoint_raw/attitude"/>
  <!-- AUTO.LAND 模式请求使用 UAV1 的 MAVROS 服务。 -->
  <arg name="set_mode_service" default="/UAV1/mavros/set_mode"/>
  <arg name="reboot_service" default="/UAV1/mavros/cmd/command"/>
  <arg name="start_trigger_topic" default="/UAV1/planning/goal"/>
  <arg name="cmd_trigger_topic" default="/UAV1/hummingbird/goal"/>
  <arg name="goal_topic" default="/UAV1/planning/goal"/>
  <arg name="planning_stop_topic" default="/mandatory_stop_to_planner"/>
  <arg name="enable_logger" default="true"/>
  <arg name="enable_rosbag" default="true"/>
  <arg name="enable_planner" default="false"/>
  <arg name="enable_controller" default="true"/>
  <arg name="enable_rviz" default="true"/>
  <arg name="rviz_goal_topic" default="/UAV1/planning/goal"/>

  <!-- Diff-Planner 继续输出完整 PolyTraj；不启动旧 px4ctrl。 -->
  <include if="$(arg enable_planner)" file="$(find diff_planner)/launch/exp/run_uav1_relay_diff.launch">
    <arg name="odom_topic" value="$(arg planner_odom_topic)"/>
    <arg name="cloud_topic" value="$(arg cloud_topic)"/>
  </include>

  <!-- 使用与 UAV0 规划器相同的 FUEL traj.rviz 配置；RViz 在规划器入口启动。 -->
  <group if="$(arg enable_planner)">
    <node if="$(arg enable_rviz)" name="UAV1_rviz" pkg="rviz" type="rviz" output="screen"
          args="-d $(find plan_manage)/config/traj.rviz" required="true">
      <remap from="/move_base_simple/goal" to="$(arg rviz_goal_topic)"/>
    </node>
  </group>

  <node if="$(arg enable_controller)" pkg="autotrans_reference_bridge" type="reference_bridge_node"
        name="autotrans_reference_bridge" output="screen">
    <param name="input_topic" value="/drone_1_planning/trajectory"/>
    <param name="output_topic" value="$(arg trajectory_topic)"/>
    <param name="frame_id" value="$(arg frame_id)"/>
  </node>

  <!-- AutoTrans 直接订阅 FAST-LIO /Odometry，只发布唯一的 attitude setpoint。 -->
  <include if="$(arg enable_controller)" file="$(find payload_mpc_controller)/launch/quad_wind_mpc_controller.launch">
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="trajectory_topic" value="$(arg trajectory_topic)"/>
    <arg name="imu_topic" value="$(arg imu_topic)"/>
    <arg name="force_attitude_odom_topic" value="$(arg force_attitude_odom_topic)"/>
    <arg name="state_topic" value="$(arg state_topic)"/>
    <arg name="extended_state_topic" value="$(arg extended_state_topic)"/>
    <arg name="rc_topic" value="$(arg rc_topic)"/>
    <arg name="battery_topic" value="$(arg battery_topic)"/>
    <arg name="esc_status_topic" value="$(arg esc_status_topic)"/>
    <arg name="setpoint_topic" value="$(arg setpoint_topic)"/>
    <arg name="set_mode_service" value="$(arg set_mode_service)"/>
    <arg name="reboot_service" value="$(arg reboot_service)"/>
    <arg name="start_trigger_topic" value="$(arg start_trigger_topic)"/>
    <arg name="cmd_trigger_topic" value="$(arg cmd_trigger_topic)"/>
    <arg name="goal_topic" value="$(arg goal_topic)"/>
    <arg name="planning_stop_topic" value="$(arg planning_stop_topic)"/>
    <arg name="planner_odom_topic" value="$(arg planner_odom_topic)"/>
    <arg name="enable_logger" value="$(arg enable_logger)"/>
    <arg name="enable_rosbag" value="$(arg enable_rosbag)"/>
  </include>
</launch>
