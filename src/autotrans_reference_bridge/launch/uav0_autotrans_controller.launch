<launch>
  <!-- 只启动 FUEL 到 AutoTrans 的桥接和 AutoTrans MPC，不启动 FUEL 规划器。 -->
  <arg name="enable_logger" default="true"/>

  <!-- 输入是 FUEL 的 B-spline，输出是 AutoTrans 实际订阅的 PolynomialTraj。 -->
  <node pkg="autotrans_reference_bridge" type="fuel_autotrans_bridge_node"
        name="fuel_autotrans_bridge" output="screen">
    <param name="input_topic" value="/UAV0/planning/bspline"/>
    <param name="output_topic" value="/UAV0/planning/autotrans_trajectory"/>
    <param name="frame_id" value="UAV0/camera_init"/>
  </node>

  <!-- AutoTrans 使用 UAV0 FAST-LIO 位姿、UAV0 MAVROS 传感器和控制接口。 -->
  <include file="$(find payload_mpc_controller)/launch/quad_wind_mpc_controller.launch">
    <arg name="odom_topic" value="/UAV0/fast_lio/Odometry"/>
    <arg name="imu_topic" value="/UAV0/mavros/imu/data"/>
    <arg name="force_attitude_odom_topic" value="/UAV0/mavros/local_position/odom"/>
    <arg name="state_topic" value="/UAV0/mavros/state"/>
    <arg name="extended_state_topic" value="/UAV0/mavros/extended_state"/>
    <arg name="rc_topic" value="/UAV0/mavros/rc/in"/>
    <arg name="battery_topic" value="/UAV0/mavros/battery"/>
    <arg name="esc_status_topic" value="/UAV0/mavros/esc_status"/>
    <arg name="setpoint_topic" value="/UAV0/mavros/setpoint_raw/attitude"/>
    <arg name="reboot_service" value="/UAV0/mavros/cmd/command"/>
    <arg name="trajectory_topic" value="/UAV0/planning/autotrans_trajectory"/>
    <arg name="safety_hold_topic" value="/UAV0/planning/safety_hold"/>
    <arg name="landing_request_topic" value="/UAV0/mission/landing_request"/>
    <arg name="enable_logger" value="$(arg enable_logger)"/>
  </include>
</launch>
