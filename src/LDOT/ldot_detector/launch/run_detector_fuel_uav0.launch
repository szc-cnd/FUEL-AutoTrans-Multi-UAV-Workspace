<launch>
    <!-- 2026-07-27: LDOT 改接 FAST-LIO 去畸变后的机体系 PointCloud2；原始 /UAV0/scan 是 livox_ros_driver/CustomMsg，与当前 LDOT 的 PointCloud2 订阅器类型不兼容。 -->
    <arg name="lidar_topic" default="/UAV0/fast_lio/cloud_registered_body"/>
    <arg name="odom_topic" default="/UAV0/fast_lio/Odometry"/>
    <arg name="global_frame" default="UAV0/camera_init"/>
    <!-- 2026-07-27: 规划器首条通道内轨迹发布后才开启 LDOT，确认门外后关闭。 -->
    <arg name="detection_enable_topic" default="/UAV0/corridor_search/dynamic_detection_enable"/>
    <arg name="enable_timing_output" default="true"/>
    <!-- 2026-07-27: 用 ROS 包路径表达 ~/match_ws 下的目录，避免写死 Linux 用户名。 -->
    <arg name="timing_output_dir" default="$(find ldot_detector)/timing"/>
    <arg name="use_rviz" default="false"/>

    <!-- 参数、节点、输出话题和服务全部隔离到 /UAV0。 -->
    <group ns="UAV0">
        <!-- 先复用完整仿真参数，再加载 UAV0/摆球覆盖层，避免维护两份大配置。 -->
        <rosparam file="$(find ldot_detector)/cfg/detector_param_sim.yaml" ns="ldot_detector"/>
        <rosparam file="$(find ldot_detector)/cfg/detector_param_fuel_uav0.yaml" ns="ldot_detector"/>
        <param name="ldot_detector/lidar_pointcloud_topic" value="$(arg lidar_topic)"/>
        <param name="ldot_detector/odom_topic" value="$(arg odom_topic)"/>
        <param name="ldot_detector/global_frame" value="$(arg global_frame)"/>
        <param name="ldot_detector/detection_enable_topic" value="$(arg detection_enable_topic)"/>
        <param name="ldot_detector/enable_timing_output" value="$(arg enable_timing_output)"/>
        <param name="ldot_detector/timing_output_dir" value="$(arg timing_output_dir)"/>

        <node pkg="ldot_detector" type="detector_node" name="ldot_detector" output="screen"/>
    </group>

    <!-- 现有双机规划 launch 已启动 RViz；需要单独调试 LDOT 时再显式开启。 -->
    <group if="$(arg use_rviz)">
        <node name="rviz_ldot_uav0" pkg="rviz" type="rviz"
              args="-d $(find ldot_detector)/rviz/detector_lv.rviz"/>
    </group>
</launch>
