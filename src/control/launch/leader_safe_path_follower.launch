<launch>
    <!-- 后机搜索降落链路默认待命，只响应 UAV0 CH9 人工触发后发布的任务消息。
         维护时可设置 UAV1_ENABLE_SEARCH_LANDING=false 完全关闭。 -->
    <arg name="enable_search_landing"
         default="$(optenv UAV1_ENABLE_SEARCH_LANDING true)"/>
    <!-- UAV1 LDOP未完成实飞验证：即使节点被单独启动，跟随器默认也不消费动态目标。 -->
    <arg name="enable_dynamic_obstacle_detection"
         default="$(optenv UAV1_ENABLE_DYNAMIC_OBSTACLE_DETECTION false)"/>
    <!-- 六分屏入口默认同时打开 UAV1 Diff-Planner 的 RViz；可通过 launch 参数关闭。 -->
    <arg name="enable_diff_rviz" default="true"/>
    <!-- 2026-07-28: 终端6同时启动UAV1独立Diff；接力管理器只发目标，traj_server唯一输出后机PositionCommand。 -->
    <include file="$(find diff_planner)/launch/exp/run_uav1_relay_diff.launch">
        <!-- 坐标对齐和后机本地可视化都由本入口各启动一份。 -->
        <arg name="publish_world_to_follower_tf" value="false"/>
        <arg name="enable_rviz" value="false"/>
    </include>
    <!-- 可视化无需消费 200 Hz 里程计；单独限频，控制器和规划器仍直接使用原高频话题。 -->
    <node if="$(arg enable_diff_rviz)" pkg="topic_tools" type="throttle"
          name="uav1_visualization_odom_throttle" output="screen"
          args="messages /UAV1/fast_lio/Odom_high_freq 30.0 /UAV1/visualization/odom_30hz"/>
    <!-- 使用唯一节点名，避免共享 Master 下与前机公共 RViz 的模型节点互相顶掉。
         使用 UAV1 双机精简配置，避免加载 exp.rviz 中 drone0～drone41 的全部显示项。 -->
    <node if="$(arg enable_diff_rviz)" pkg="odom_visualization"
          name="uav1_local_odom_visualization" type="odom_visualization"
          output="screen">
        <remap from="~odom" to="/UAV1/visualization/odom_30hz"/>
        <remap from="~cmd" to="/UAV1/planning/pos_cmd"/>
        <remap from="~path" to="/drone_1_odom_visualization/path"/>
        <remap from="~robot" to="/drone_1_odom_visualization/robot"/>
        <remap from="~robot_array" to="/drone_1_odom_visualization/robot_array"/>
        <param name="color/a" value="1.0"/>
        <param name="color/r" value="0.0"/>
        <param name="color/g" value="0.35"/>
        <param name="color/b" value="1.0"/>
        <param name="covariance_scale" value="100.0"/>
        <param name="robot_scale" value="0.35"/>
        <param name="frame_id" value="UAV1/camera_init"/>
        <param name="use_cmd_yaw_for_mesh" value="true"/>
        <param name="cmd_yaw_timeout" value="0.8"/>
        <param name="rotate_yaw_deg" value="90.0"/>
        <param name="tf45" value="false"/>
        <param name="drone_id" value="1"/>
    </node>
    <node if="$(arg enable_diff_rviz)" name="UAV1_diff_rviz"
          pkg="rviz" type="rviz"
          args="-d $(find diff_planner)/launch/include/uav1_lite.rviz" output="screen">
        <!-- NoMachine/NX 的 llvmpipe 在点云和多路图像并发渲染时会进入 swrast 段错误；
             改用单线程 softpipe，优先保证实飞 RViz 稳定。 -->
        <env name="GALLIUM_DRIVER" value="softpipe"/>
        <env name="LP_NUM_THREADS" value="1"/>
        <env name="MESA_GLTHREAD" value="false"/>
        <remap from="/move_base_simple/goal" to="/UAV1/planning/goal"/>
        <remap from="/drone__diff_planner_node/goal_point"
               to="/drone_1_diff_planner_node/goal_point"/>
        <remap from="/diff_planner_node/global_list"
               to="/drone_1_diff_planner_node/global_list"/>
        <remap from="/diff_planner_node/a_star_list"
               to="/drone_1_diff_planner_node/a_star_list"/>
    </node>
    <!-- UAV1 复用同一套搜索/精降节点；相机驱动和 UAV1/down_camera 话题由机载入口提供。 -->
    <include if="$(arg enable_search_landing)"
             file="$(find precision_landing)/launch/precision_landing.launch">
        <arg name="vehicle_ns" value="UAV1"/>
        <arg name="image_topic" value="/UAV1/down_camera/image_raw"/>
        <arg name="camera_info_topic" value="/UAV1/down_camera/camera_info"/>
        <arg name="odometry_topic" value="/UAV1/fast_lio/Odom_high_freq"/>
        <arg name="mission_status_topic" value="/UAV0/mission/task_status"/>
        <arg name="landing_marker_world_topic" value="/UAV1/mission/detection/final_aruco"/>
        <arg name="landing_search_config"
             value="$(find precision_landing)/config/landing_search.yaml"/>
        <!-- 搜索和最终精降都在基础配置之后加载 UAV1 专用 camera_to_body。 -->
        <arg name="camera_extrinsic_config"
             value="$(find precision_landing)/config/down_camera_extrinsic_uav1.yaml"/>
        <arg name="enable_front_aruco_hint" value="false"/>
        <arg name="require_platform_assignment" value="true"/>
        <!-- UAV1 飞往粗平台航点途中一旦稳定识别到分配的同一 ArUco，立即交给精降。 -->
        <arg name="early_handoff_on_assigned_marker" value="true"/>
        <arg name="early_handoff_authorization_topic"
             value="/dual_uav_landing/release_uav1"/>
    </include>
    <!-- 2026-07-16: 后机不运行第二套FUEL；执行门点、持续滚动内部接力点和真实终点。 -->
    <!-- 2026-07-27: 后机接力链路的全部双机话题前缀统一为 UAV0/UAV1。 -->
    <arg name="leader_odom_topic" default="/UAV0/fast_lio/Odom_high_freq"/>
    <arg name="leader_history_path_topic" default="/UAV0/fast_lio/path"/>
    <arg name="follower_odom_topic" default="/UAV1/fast_lio/Odom_high_freq"/>
    <arg name="follower_cloud_topic" default="/UAV1/fast_lio/cloud_registered"/>
    <arg name="leader_trajectory_topic" default="/UAV0/planning/bspline"/>
    <arg name="frame_alignment_config"
         default="$(find exploration_control)/config/dual_uav_frame_alignment.yaml"/>

    <!-- TF、跨机航点和双机距离判断只读取这一份对齐配置。 -->
    <rosparam command="load" file="$(arg frame_alignment_config)"/>
    <node pkg="exploration_control" type="dual_uav_frame_alignment"
          name="dual_uav_frame_alignment" output="screen" required="true"/>

    <node pkg="exploration_control" type="leader_safe_path_follower"
          name="leader_safe_path_follower" output="screen">
        <!-- 2026-07-14: 1.2m 路径滞后和 0.75m 硬间距用于当前 1m 初始纵队的保守跟随验证。 -->
        <param name="leader_odom_topic" value="$(arg leader_odom_topic)"/>
        <param name="leader_history_path_topic"
               value="$(arg leader_history_path_topic)"/>
        <param name="follower_odom_topic" value="$(arg follower_odom_topic)"/>
        <param name="follower_cloud_topic" value="$(arg follower_cloud_topic)"/>
        <param name="leader_trajectory_topic" value="$(arg leader_trajectory_topic)"/>
        <param name="enable_search_landing" value="$(arg enable_search_landing)"/>
        <param name="enable_dynamic_obstacle_detection"
               value="$(arg enable_dynamic_obstacle_detection)"/>
        <!-- 2026-07-29: 不再依赖 start_after_hover；双机分别达到高度后锁存就绪，
             UAV1 仍要等接力目标发布并由 Diff 生成真实轨迹后才运动。 -->
        <param name="leader_start_height" value="0.3"/>
        <param name="follower_start_height" value="0.3"/>
        <param name="min_record_height" value="0.3"/>
        <param name="command_topic" value="/UAV1/planning/pos_cmd"/>
        <!-- 2026-07-28: 禁止接力管理器直控后机，改向UAV1 Diff发布离散目标。 -->
        <param name="use_diff_planner" value="true"/>
        <!-- 前机每段实际停稳终点按FIFO缓存；后机一次只把队首原坐标交给Diff，
             到达后删除。失败只重试同一点，不生成候选、裁短或退让目标。 -->
        <param name="simple_segment_endpoint_following" value="true"/>
        <param name="simple_diff_retry_delay" value="0.20"/>
        <param name="diff_goal_topic" value="/UAV1/planning/goal"/>
        <!-- 2026-07-28: 仅在3秒内连规划状态都未收到时重发，禁止飞行中1Hz覆盖Diff轨迹。 -->
        <param name="diff_goal_retry_period" value="3.0"/>
        <!-- 看门狗正常在1.2s重启假死规划器；2.0s总应答上限是独立的第二道保险。 -->
        <param name="diff_goal_response_timeout" value="2.0"/>
        <!-- 前向点失败后短时拉黑并换UAV0历史轨迹相邻点；一组候选均失败时沿UAV1自身实飞栈退让。 -->
        <param name="diff_status_topic" value="/drone_1_planning/status"/>
        <param name="diff_recovery_arrive_radius" value="0.18"/>
        <param name="diff_failure_retreat_distance" value="0.40"/>
        <param name="diff_failure_retreat_arrive_radius" value="0.10"/>
        <param name="diff_candidate_blacklist_duration" value="4.0"/>
        <param name="diff_candidate_blacklist_radius" value="0.08"/>
        <param name="diff_forward_failures_before_retreat" value="3"/>
        <param name="diff_clipped_retry_limit" value="2"/>
        <param name="follower_history_sample_spacing" value="0.08"/>
        <param name="follower_history_max_length" value="30.0"/>
        <!-- 优先使用UAV0每段B-spline实际停稳终点；允许搜索7m内的远端安全停稳点。 -->
        <param name="diff_history_target_max_distance" value="7.00"/>
        <param name="leader_segment_endpoint_radius" value="0.20"/>
        <param name="leader_segment_endpoint_max_speed" value="0.12"/>
        <param name="leader_segment_endpoint_dwell" value="0.25"/>
        <param name="traj_started_topic" value="/UAV1/planning/traj_started"/>
        <!-- 2026-07-27: 前机确认终点后，跟随器发布后机邻近落点并在到达后触发 UAV1 AUTO.LAND。 -->
        <param name="leader_landing_target_topic" value="/UAV0/mission/landing_target"/>
        <param name="leader_landing_request_topic" value="/UAV0/mission/landing_request"/>
        <param name="follower_landing_target_topic" value="/UAV1/mission/landing_target"/>
        <param name="follower_landing_request_topic" value="/UAV1/mission/landing_request"/>
        <param name="follower_landing_trigger_topic" value="/UAV1/need_to_land"/>
        <param name="release_uav1_topic" value="/dual_uav_landing/release_uav1"/>
        <param name="follower_assigned_target_topic" value="/UAV1/landing/assigned_target"/>
        <!-- 2026-07-15: workspace_lock 只在门确认后锁存发布，比 entry_pose 的搜索期参考点可靠。 -->
        <param name="door_pose_topic" value="/UAV0/corridor_search/workspace_lock"/>
        <!-- 2026-07-28: 仅接收前机达到锁门里程后发布的最终出口；后机在前机出门后按入口式离散点执行。 -->
        <param name="final_exit_pose_topic" value="/UAV0/mission/final_exit"/>
        <!-- 最终门心仍按历史轨迹到达；随后沿门朝外yaw直行0.5m，在通道外稳定悬停。 -->
        <param name="outside_door_distance" value="0.50"/>
        <param name="history_path_join_tolerance" value="0.35"/>
        <!-- 前视不足两码并切换下视后，等UAV0实测升高再让UAV1前往前视扫描锚点。 -->
        <param name="landing_search_state_topic" value="/landing_diff_search_manager/state"/>
        <param name="front_scan_anchor_topic" value="/UAV0/landing/front_scan_anchor"/>
        <param name="down_search_release_height" value="1.80"/>
        <param name="down_search_min_vertical_separation" value="1.00"/>
        <!-- 2026-07-16: 前机公开发布滚动任务接力点，后续双计算机只需桥接这个低带宽Path话题。 -->
        <param name="relay_path_topic" value="/UAV0/mission/relay_waypoints"/>
        <!-- 出口前沿前机实飞XY折线保持0.70m滞后；后机名义高度与起飞悬停统一为0.60m。 -->
        <!-- 2026-07-28: Diff按释放后的目标独立搜索避障轨迹，不再用50Hz移动目标追逐前机。 -->
        <param name="continuous_follow_before_exit" value="false"/>
        <!-- 2026-07-27: 后机通道连续跟随速度上限与前机 FUEL 的 0.5m/s 对齐，避免长期速度差持续放大跟随滞后。 -->
        <param name="continuous_follow_speed" value="0.50"/>
        <!-- 2026-07-27: FUEL 已将任务状态隔离到前机 UAV0，跟随器同步订阅该前缀。 -->
        <param name="leader_task_status_topic" value="/UAV0/mission/task_status"/>
        <!-- 后机在入门目标释放后独立开启LDOP。 -->
        <param name="follower_detection_enable_topic" value="/UAV1/corridor_search/dynamic_detection_enable"/>
        <param name="follow_distance" value="0.70"/>
        <param name="release_path_length" value="0.70"/>
        <!-- Diff持续间距保护：0.70m内刹停；前机继续后退压到0.50m内时，UAV1主动后退。 -->
        <param name="enable_diff_separation_safety" value="true"/>
        <param name="min_separation" value="0.70"/>
        <!-- UAV0 只在两机对齐坐标系下的实时水平距离达到0.70m后，才向UAV1释放普通航点。 -->
        <param name="waypoint_release_min_separation" value="0.70"/>
        <!-- 不接收前机z；名义0.60m，只有自身点云线段受阻才允许上探到0.70m。 -->
        <param name="fixed_follow_height" value="0.60"/>
        <param name="follow_height_min" value="0.60"/>
        <param name="follow_height_max" value="0.70"/>
        <!-- 前机偏离0.6m超过0.1m通常正在上下避障；保留XY路线，但不选该点作为后机规划终点。 -->
        <param name="leader_route_height_tolerance" value="0.10"/>
        <param name="separation_recovery_distance" value="0.50"/>
        <param name="separation_release_distance" value="0.70"/>
        <param name="emergency_retreat_step" value="0.35"/>
        <param name="emergency_retreat_speed" value="0.30"/>
        <!-- 2026-07-16: 后机落点取前机安全轨迹末端后方约0.5m；终点模式关闭两机距离条件。 -->
        <param name="terminal_landing_spacing" value="0.50"/>
        <param name="terminal_approach_height" value="2.00"/>
        <param name="terminal_arrive_radius" value="0.25"/>
        <param name="terminal_arrive_z_tolerance" value="0.15"/>
        <param name="terminal_arrive_dwell" value="1.0"/>
        <param name="terminal_approach_speed" value="0.25"/>
        <!-- 2026-07-27: 后机普通接力巡航上限同步设为 0.5m/s；接近接力点、终点和紧急退让仍使用各自的低速参数。 -->
        <param name="cruise_speed" value="0.50"/>
        <param name="max_target_step" value="0.55"/>
        <!-- 2026-07-15: 每次只沿前机历史折线前视0.30m，避免在U形/直角通道直接连远端滞后点切墙。 -->
        <param name="route_tracking_lookahead" value="0.30"/>
        <!-- 跨机高频里程计积压时保持UAV1等待，禁止用超过0.5s的历史位置做放行判断。 -->
        <param name="leader_odom_max_transport_age" value="0.50"/>
        <!-- 2026-07-21: 用最近0.45m实飞路线切线判定前进，不使用当前不随转弯更新的雷达yaw；
             投影<-0.20且累计倒退0.60m才暂停，正常直角/U形转弯可连续生成接力点。 -->
        <param name="forward_projection_ratio" value="-0.20"/>
        <param name="route_direction_window" value="0.45"/>
        <param name="backtrack_pause_distance" value="0.60"/>
        <param name="route_resume_radius" value="0.45"/>
        <!-- 2026-07-21: U形转弯负投影轨迹离开旧路线0.5m后确认为新分支，恢复接力且保留完整弯曲路径。 -->
        <param name="turn_branch_confirm_distance" value="0.50"/>
        <!-- 门点及内部接力点都等前机沿路线清空0.70m，并通过上方实时双机距离检查。 -->
        <param name="door_release_inside_distance" value="0.70"/>
        <param name="relay_release_distance" value="0.70"/>
        <param name="relay_waypoint_spacing" value="2.50"/>
        <param name="relay_arrive_radius" value="0.25"/>
        <param name="relay_arrive_z_tolerance" value="0.20"/>
        <!-- 较大圆柱净空仅用于最终降落点；普通接力点只检查精确落点小体素。 -->
        <param name="relay_endpoint_clearance_radius" value="0.38"/>
        <param name="relay_endpoint_z_margin" value="0.28"/>
        <param name="relay_endpoint_min_points" value="2"/>
        <param name="relay_point_occupied_radius" value="0.12"/>
        <param name="relay_point_occupied_z_margin" value="0.18"/>
        <param name="relay_point_occupied_min_points" value="2"/>
        <param name="relay_point_check_distance" value="0.45"/>
        <param name="relay_occupied_attachment_radius" value="0.35"/>
        <!-- 关闭普通接力目标的点云净空预检查；轨迹碰撞检查仍由Diff Planner负责。 -->
        <param name="enable_relay_goal_clearance" value="false"/>
        <param name="relay_goal_clearance_radius" value="0.20"/>
        <param name="relay_goal_clearance_z_margin" value="0.30"/>
        <param name="relay_goal_clearance_min_points" value="2"/>
        <param name="relay_goal_backtrack_max_distance" value="1.00"/>
        <param name="relay_slowdown_radius" value="0.55"/>
        <param name="relay_approach_speed" value="0.20"/>
        <param name="relay_arrive_max_horizontal_speed" value="0.10"/>
        <param name="relay_arrive_max_vertical_speed" value="0.08"/>
        <param name="relay_arrive_dwell" value="0.50"/>
        <!-- 2026-07-28: 普通接力点进入15cm后先锁点0.45s，避免轨迹结束与速度门槛之间形成到点死锁。 -->
        <param name="diff_endpoint_capture_radius" value="0.15"/>
        <param name="diff_endpoint_capture_dwell" value="0.45"/>
        <!-- Diff裁短终点超过0.20m时只算中间步，禁止误报原接力点到达。 -->
        <param name="diff_accepted_goal_tolerance" value="0.20"/>
        <!-- 2026-07-28: PositionCommand停止0.8s且尚未到点时重发当前Diff目标。 -->
        <param name="diff_command_stale_timeout" value="0.80"/>
        <!-- 2026-07-16: 0表示不限制内部接力点数量，避免长赛道在固定5点耗尽后永久等待。 -->
        <param name="max_internal_relay_points" value="0"/>
        <!-- 2026-07-16: 仿真Mid360点云稀疏，8点门限会漏掉真实墙面；恢复3点并扩大到0.28m包络。 -->
        <param name="obstacle_check_enabled" value="true"/>
        <param name="require_fresh_cloud" value="true"/>
        <param name="obstacle_radius" value="0.28"/>
        <param name="obstacle_z_margin" value="0.25"/>
        <param name="obstacle_min_points" value="3"/>
        <!-- 后机订阅LDOP结构化状态并自行做1秒匀速预测。 -->
        <param name="dynamic_obstacle_topic" value="/UAV1/ldop/dynamic_objects"/>
        <param name="dynamic_obstacle_retention" value="1.50"/>
        <param name="dynamic_obstacle_safety_radius" value="0.35"/>
        <param name="dynamic_obstacle_z_margin" value="0.18"/>
        <!-- 2026-07-28: 赛题摆球不会触墙；仅保留距前机已验证通道中心路线0.70m内的框，墙边/穿墙预测直接丢弃。 -->
        <param name="dynamic_retention_route_half_width" value="0.70"/>
        <!-- 2026-07-28: 识别7月27日实验中的FAST-LIO发散，并切换控制器MAVROS锁点保护。 -->
        <param name="follower_odom_jump_speed" value="2.0"/>
        <param name="follower_odom_jump_vertical_speed" value="1.2"/>
        <param name="follower_odom_jump_confirm_samples" value="3"/>
        <!-- 2026-07-27: 后机持续有速度指令但1.5s内位移不足6cm时，按自身点云选择侧向/退向短目标脱困。 -->
        <param name="stuck_detection_timeout" value="1.50"/>
        <param name="stuck_min_progress" value="0.06"/>
        <param name="recovery_step" value="0.35"/>
        <param name="recovery_speed" value="0.20"/>
        <param name="recovery_attempt_timeout" value="1.50"/>
        <param name="recovery_success_distance" value="0.12"/>
        <param name="recovery_near_ignore" value="0.06"/>
        <!-- 点云阻挡1秒触发局部脱困；当前缓存点未到达前始终保持，不允许自动跳点。 -->
        <param name="blocked_recovery_timeout" value="1.00"/>
    </node>
</launch>
