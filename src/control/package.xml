<?xml version="1.0"?>
<package format="2">
  <name>exploration_control</name>
  <version>0.0.0</version>
  <description>The cxr_egoctrl_v1 package</description>

  <maintainer email="cxr@todo.todo">cxr</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- Existing dependencies -->
  <build_depend>geometry_msgs</build_depend>
  <!-- 2026-07-14: 后机跟随器需要双机里程计、注册点云和 RViz 路径/状态标记。 -->
  <build_depend>nav_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>quadrotor_msgs</build_depend>
  <build_depend>tf</build_depend>
  <build_depend>tf2</build_depend>
  <build_depend>tf2_ros</build_depend>
  <!-- 2026-07-13: 安全悬停后支持通过 MAVROS SetMode 执行终点自动降落。 -->
  <build_depend>mavros_msgs</build_depend>
  <!-- 后机消费LDOP动态目标状态并在控制侧进行短期预测。 -->
  <build_depend>ldop</build_depend>

  <build_export_depend>geometry_msgs</build_export_depend>
  <!-- 2026-07-14: 向依赖本包的节点导出后机安全跟随消息依赖。 -->
  <build_export_depend>nav_msgs</build_export_depend>
  <build_export_depend>sensor_msgs</build_export_depend>
  <build_export_depend>visualization_msgs</build_export_depend>
  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>rospy</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>quadrotor_msgs</build_export_depend>
  <build_export_depend>tf</build_export_depend>
  <build_export_depend>tf2</build_export_depend>
  <build_export_depend>tf2_ros</build_export_depend>
  <build_export_depend>mavros_msgs</build_export_depend>
  <build_export_depend>ldop</build_export_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <!-- 2026-07-14: 运行后机安全跟随节点所需消息包。 -->
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>quadrotor_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>tf2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>ldop</exec_depend>

  <export>
  </export>
</package>
