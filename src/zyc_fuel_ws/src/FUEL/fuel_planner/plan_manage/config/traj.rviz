          Namespaces:
            {}
          Queue Size: 100
          Value: true
        # 2026-07-13: 默认显示第二阶段已搜索覆盖和颜色/二维码/温度目标标记。
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /UAV0/mission/search_markers
          Name: task_search
          Namespaces:
            {}
          Queue Size: 100
          Value: true
      Enabled: true
      Name: active_perception
