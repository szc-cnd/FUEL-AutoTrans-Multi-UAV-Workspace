Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Planning1
        - /active_perception1
        - /active_perception1/frontier1
        - /active_perception1/frontier1/Namespaces1
        - /active_perception1/viewpoint1/Namespaces1
        - /LocalMap1/occupied_local1/Autocompute Value Bounds1
        - /LocalMap1/occupied_all1
        - /LocalMap1/occupied_all1/Autocompute Value Bounds1
        - /Simulation1
        - /debug21/Autocompute Value Bounds1
        - /processed_msg1/Namespaces1
        - /PointCloud21
        - /PointCloud21/Autocompute Value Bounds1
        - /Marker1
        - /Axes2
        - /Path1
      Splitter Ratio: 0.5216138362884521
    Tree Height: 664
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: occupied_local_inflate
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Class: rviz/Axes
      Enabled: false
      Length: 20
      Name: Axes
      Radius: 0.10000000149011612
      Reference Frame: <Fixed Frame>
      Show Trail: false
      Value: false
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Group
      Displays:
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /UAV0/target_reporting/markers
          Name: detection_targets
          Namespaces:
            {}
          Queue Size: 100
          Value: true
        - Class: rviz/Image
          Enabled: false
          Image Topic: /UAV0/color_tag_detector/debug_image
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: color_detection_image
          Normalize Range: true
          Queue Size: 2
          Transport Hint: raw
          Unreliable: false
          Value: false
        - Class: rviz/Image
          Enabled: false
          Image Topic: /UAV0/vision/qr_debug_image
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: qr_detection_image
          Normalize Range: true
          Queue Size: 2
          Transport Hint: raw
          Unreliable: false
          Value: false
        - Class: rviz/Image
          Enabled: false
          Image Topic: /UAV0/thermal/debug_image
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: thermal_detection_image
          Normalize Range: true
          Queue Size: 2
          Transport Hint: raw
          Unreliable: false
          Value: false
        # The filtered target cloud is for context only; lower opacity and
        # smaller cells keep detection markers/text readable in the planner RViz.
        - Alpha: 0.25
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 140; 0
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 4096
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: detected_object_cloud
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.006
          Style: Flat Squares
          Topic: /UAV0/target_reporting/detected_object_cloud
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /UAV0/target_reporting/detected_object_boxes
          Name: detected_object_boxes
          Namespaces:
            {}
          Queue Size: 20
          Value: true
      Enabled: true
      Name: Detection Results
    - Class: rviz/Group
      Displays:
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /UAV0/planning_vis/trajectory
          Name: bspline_traj
          Namespaces:
            {}
          Queue Size: 100
          Value: true
        - Class: rviz/Marker
          Enabled: false
          Marker Topic: /UAV0/planning_vis/yaw
          Name: yaw_traj
          Namespaces:
            {}
          Queue Size: 100
          Value: false
        - Class: rviz/Marker
          Enabled: false
          Marker Topic: /UAV0/planning_vis/topo_path
          Name: topo_path
          Namespaces:
            {}
          Queue Size: 100
          Value: false
        - Class: rviz/Marker
          Enabled: true
          # 2026-07-27: RViz 的前机规划、地图、门识别和任务可视化话题统一切换到 UAV0。
          Marker Topic: /UAV0/planning/travel_traj
          Name: executed_traj
          Namespaces:
            {}
          Queue Size: 100
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /UAV0/planning/position_cmd_vis
          Name: position_cmd
          Namespaces:
            {}
          Queue Size: 100
          Value: true
      Enabled: true
      Name: Planning
    # 2026-07-27: 在双机主RViz直接显示LDOT动态点、确认框和预测轨迹，避免另开RViz才能判断是否漏检。
    - Class: rviz/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 40; 40
          Color Transformer: FlatColor
          Decay Time: 0.3
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: dynamic_points
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 5
          Size (m): 0.06
          Style: Flat Squares
          Topic: /UAV0/ldot_detector/dynamic_point_cloud
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /UAV0/ldot_detector/dynamic_bboxes
          Name: dynamic_bboxes
          Namespaces: {}
          Queue Size: 20
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /UAV0/ldot_detector/dynamic_trajectories
          Name: dynamic_predictions
          Namespaces: {}
          Queue Size: 20
          Value: true
      Enabled: true
      Name: LDOT_Dynamic
    # 2026-07-27: 后机独立LDOT显示，输出命名空间与UAV0检测器分离。
    - Class: rviz/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 80; 160; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: UAV1_dynamic_points
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 5
          Size (m): 0.06
          Style: Flat Squares
          Topic: /UAV1/UAV0/ldot_detector/dynamic_point_cloud
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /UAV1/UAV0/ldot_detector/dynamic_bboxes
          Name: UAV1_dynamic_bboxes
          Namespaces: {}
          Queue Size: 20
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /UAV1/UAV0/ldot_detector/dynamic_trajectories
          Name: UAV1_dynamic_predictions
          Namespaces: {}
          Queue Size: 20
          Value: true
      Enabled: true
      Name: UAV1_LDOT_Dynamic
    - Class: rviz/Group
      Displays:
        - Class: rviz/Marker
          Enabled: false
          Marker Topic: /UAV0/planning_vis/frontier
          Name: frontier
          Namespaces:
            {}
          Queue Size: 10000
          Value: false
        - Class: rviz/Marker
          # 2026-07-14: 默认关闭规划 viewpoint 线框，避免把右上角红色视野三角误认为里程计机体；
          # 真实里程计机体保留在 Simulation/robot。
          Enabled: false
          Marker Topic: /UAV0/planning_vis/viewpoints
          Name: viewpoint
          Namespaces:
            {}
          Queue Size: 1000
          Value: false
        - Class: rviz/Marker
          Enabled: false
          Marker Topic: /heading_planner/box
          Name: AABB
          Namespaces:
            {}
          Queue Size: 100
          Value: false
        - Class: rviz/Marker
