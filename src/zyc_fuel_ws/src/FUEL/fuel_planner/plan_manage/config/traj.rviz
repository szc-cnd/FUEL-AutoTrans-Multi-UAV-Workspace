    - Class: rviz/Group
      Displays:
        - Alpha: 0.019999999552965164
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 2
            Min Value: -1
            Value: false
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 161; 161; 161
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: simulation_map
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.10000000149011612
          Style: Flat Squares
          Topic: /map_generator/global_cloud
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Class: rviz/Marker
          Enabled: true
          # 2026-07-27: 跟随 UAV0 显式里程计可视化输出，避免显示旧全局 latched marker 造成坐标错位假象。
          Marker Topic: /UAV0/odom_visualization/robot
          Name: UAV0_robot
          Namespaces:
            {}
          Queue Size: 100
          Value: true
        # 2026-07-27: 在同一个 RViz 中显示后机蓝色机体，位置由 world->UAV1/camera_init TF 对齐。
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /UAV1/odom_visualization/robot
          Name: UAV1_robot
          Namespaces:
            {}
          Queue Size: 100
          Value: true
        # 2026-07-14: 分别显示前机和后机的真实 FAST-LIO 里程计历史，便于检查跟随距离和漂移。
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 20; 20; 20
          Enabled: true
          Head Diameter: 0.2
          Head Length: 0.1
          Length: 0.2
          Line Style: Billboards
          Line Width: 0.04
          Name: UAV0_odom_path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 20; 20; 20
          Pose Style: None
          Queue Size: 10
          Radius: 0.02
          Shaft Diameter: 0.05
          Shaft Length: 0.05
          Topic: /UAV0/odom_visualization/path
          Unreliable: false
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 0; 90; 255
          Enabled: true
          Head Diameter: 0.2
          Head Length: 0.1
          Length: 0.2
          Line Style: Billboards
          Line Width: 0.04
          Name: UAV1_odom_path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 0; 90; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.02
          Shaft Diameter: 0.05
          Shaft Length: 0.05
          Topic: /UAV1/odom_visualization/path
          Unreliable: false
          Value: true
        # 2026-07-14: 显示前机已经实际飞过、可供后机跟随的公共坐标安全历史路径。
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 0; 210; 255
          Enabled: true
          Head Diameter: 0.2
          Head Length: 0.1
          Length: 0.2
          Line Style: Billboards
          Line Width: 0.06
          Name: leader_safe_route
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 0; 210; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.02
          Shaft Diameter: 0.05
          Shaft Length: 0.05
          Topic: /leader_safe_path_follower/leader_safe_route
          Unreliable: false
          Value: true
        # 2026-07-16: 绿色折线只显示前机已经释放给后机的最多5个任务点，不等同于前机稠密历史轨迹。
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 40; 230; 80
          Enabled: true
          Head Diameter: 0.2
          Head Length: 0.1
          Length: 0.2
          Line Style: Billboards
          Line Width: 0.09
          Name: released_relay_waypoints
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 40; 230; 80
          Pose Style: Axes
          Queue Size: 10
          Radius: 0.03
          Shaft Diameter: 0.05
          Shaft Length: 0.05
          Topic: /UAV0/mission/relay_waypoints
          Unreliable: false
          Value: true
        # 2026-07-16: 蓝球为后机当前接力点，文字显示等待门、等待下一点、执行接力或终点降落状态。
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /leader_safe_path_follower/target_marker
          Name: follower_target
          Namespaces:
            {}
          Queue Size: 10
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /leader_safe_path_follower/state_marker
          Name: follower_state
          Namespaces:
            {}
          Queue Size: 10
          Value: true
      Enabled: true
      Name: Simulation
    - Class: rviz/Group
